# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Datasets - multi-GB, not for Git. Fetch with analysis/download_data.sh
data/reviews/*
data/meta/*
!data/reviews/.gitkeep
!data/meta/.gitkeep

# Pipeline output - Parquet results, regenerated by running the pipeline
output/*
!output/.gitkeep
# ...except the EMR run artefacts, which cannot be regenerated without paying
# for another cluster: the S3 bucket they came from has been deleted.
!output/emr/
checkpoints/*

# Local environment
.env
.venv/
venv/

# OS
.DS_Store
# Local run logs are kept: they hold the stage timings cited in the report.
!logs
aws/MY_KEY.pem

# LaTeX build artifacts - the .tex and .pdf are tracked, intermediates are not
*.aux
*.toc
*.out
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
report/*.log
